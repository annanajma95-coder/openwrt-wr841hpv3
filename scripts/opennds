config opennds
	option enabled '1'
	option fwhook_enabled '1'
	option use_outdated_mhd '1'
	option unescape_callback_enabled '0'
	option gatewayinterface 'br-voucher'
	option gatewayname 'Hotspot Voucher'
	option maxclients '250'
	option preauthidletimeout '30'
	option authidletimeout '120'
	option sessiontimeout '1200'
	option checkinterval '15'
	option uploadrate '0'
	option downloadrate '0'
	option ratecheckwindow '2'
	option uploadquota '0'
	option downloadquota '0'
	# Allow authenticated voucher clients to reach the internet.
	list authenticated_users 'allow tcp port 53'
	list authenticated_users 'allow udp port 53'
	list authenticated_users 'allow udp port 67'
	list authenticated_users 'allow tcp port 2050'
	list authenticated_users 'allow all'
	# Keep pre-authentication access to the router restricted to portal/DNS/DHCP.
	list users_to_router 'allow tcp port 53'
	list users_to_router 'allow udp port 53'
	list users_to_router 'allow udp port 67'
	list users_to_router 'allow tcp port 2050'
	option login_option_enabled '0'
	option preauth '/usr/lib/opennds/voucher.sh'
